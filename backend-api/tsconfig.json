{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": false,
    "verbatimModuleSyntax": true,
    "paths": {
      "@roadwatch/core": ["../packages/core/src/index.ts"],
      "@roadwatch/core/src/*": ["../packages/core/src/*"],
      "@roadwatch/adapters": ["../packages/adapters/src/index.ts"],
      "@roadwatch/adapters/src/*": ["../packages/adapters/src/*"],
      "@roadwatch/kafka": ["../packages/kafka/index.ts"],
      "@roadwatch/kafka/src/*": ["../packages/kafka/*"],
      "@roadwatch/redis": ["../packages/redis/index.ts"]
    }
  },
  "include": ["./src/**/*"],
  "exclude": ["node_modules", "dist"]
}
