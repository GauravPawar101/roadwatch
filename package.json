{
  "name": "roadwatch",
  "private": true,
  "packageManager": "pnpm@8.10.0",
  "pnpm": {
    "neverBuiltDependencies": [
      "pkcs11js"
    ]
  },
  "workspaces": [
    "apps/*",
    "backend-api",
    "frontend",
    "packages/*",
    "packages/core",
    "packages/config",
    "packages/features/*",
    "packages/providers/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "----SETUP----": "",
    "setup": "node ./ops/dev/run.mjs setup",
    "setup:skip-install": "node ./ops/dev/run.mjs setup --skip-install",
    "bootstrap": "node ./ops/dev/run.mjs setup",
    "verify:bootstrap": "node ./ops/dev/run.mjs verify-bootstrap",

    "----DEV (all services in parallel)----": "",
    "start:all": "node ./ops/dev/run.mjs start-all",
    "start:all:k8s": "node ./ops/dev/run.mjs start-all --kubernetes",
    "stop:all": "node ./ops/dev/run.mjs stop-all",
    "init:messaging": "node ./ops/dev/run.mjs init-messaging",
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @roadwatch/gateway-api dev",
    "dev:backend": "pnpm --filter @roadwatch/backend-api dev",
    "dev:frontend": "pnpm --filter roadwatch-frontend dev",
    "dev:services": "turbo run dev --filter=@roadwatch/scheduler --filter=@roadwatch/webhook-handler --filter=@roadwatch/fabric-anchor-consumer --parallel",
    "dev:scheduler": "pnpm --filter @roadwatch/scheduler dev",
    "dev:webhook": "pnpm --filter @roadwatch/webhook-handler dev",
    "dev:fabric-consumer": "pnpm --filter @roadwatch/fabric-anchor-consumer dev",

    "----BUILD----": "",
    "build": "turbo run build",
    "build:api": "pnpm --filter @roadwatch/gateway-api build",
    "build:backend": "pnpm --filter @roadwatch/backend-api build",
    "build:frontend": "pnpm --filter roadwatch-frontend build",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:chaincode": "pnpm --filter roadwatch-chaincode build",

    "----TEST----": "",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=@roadwatch/core",
    "test:api": "pnpm --filter @roadwatch/gateway-api test",
    "test:backend": "pnpm --filter @roadwatch/backend-api test",
    "test:integration": "turbo run test --filter=@roadwatch/gateway-api",
    "test:prompts": "tsx tools/prompt-tests/run.ts",
    "test:fabric": "vitest run -c tests/fabric/vitest.config.ts",
    "test:watch:api": "pnpm --filter @roadwatch/gateway-api test:watch",
    "test:watch:core": "pnpm --filter @roadwatch/core test:watch",
    "test:coverage": "pnpm --filter @roadwatch/core test:coverage",
    "test:coverage:gateway": "pnpm --filter @roadwatch/gateway-api test:coverage",
    "test:coverage:backend": "pnpm --filter @roadwatch/backend-api test:coverage",
    "benchmarks:coverage": "pnpm test:coverage && pnpm test:coverage:gateway && pnpm test:coverage:backend",
    "benchmarks:kind-soak": "node ./tools/benchmarks/run-kind-soak.mjs",

    "----TYPECHECK----": "",
    "typecheck": "turbo run typecheck",
    "typecheck:api": "pnpm --filter @roadwatch/gateway-api typecheck",
    "typecheck:backend": "pnpm --filter @roadwatch/backend-api typecheck",
    "typecheck:mobile": "pnpm --filter @roadwatch/mobile-host typecheck",
    "typecheck:packages": "turbo run typecheck --filter=./packages/*",

    "----LINT----": "",
    "lint": "turbo run lint",
    "lint:mobile": "pnpm --filter @roadwatch/mobile-host lint",

    "----MOBILE----": "",
    "mobile": "pnpm --filter @roadwatch/mobile-host start",
    "mobile:android": "pnpm --filter @roadwatch/mobile-host android",
    "mobile:ios": "pnpm --filter @roadwatch/mobile-host ios",
    "mobile:pods": "pnpm --filter @roadwatch/mobile-host pod-install",
    "mobile:clean": "pnpm --filter @roadwatch/mobile-host clean",
    "start": "pnpm --filter @roadwatch/mobile-host start",
    "ios": "pnpm --filter @roadwatch/mobile-host ios",
    "android": "pnpm --filter @roadwatch/mobile-host android",

    "----INFRASTRUCTURE----": "",
    "infra:up": "node ./ops/dev/run.mjs compose up -d",
    "infra:down": "node ./ops/dev/run.mjs compose down",
    "infra:reset": "node ./ops/dev/run.mjs compose down --volumes",
    "infra:logs": "node ./ops/dev/run.mjs compose logs -f",
    "infra:ps": "node ./ops/dev/run.mjs compose ps",

    "----FABRIC----": "",
    "fabric:start": "node ./ops/dev/run.mjs fabric-start",
    "fabric:deploy": "node ./ops/dev/run.mjs fabric-deploy",
    "fabric:reset": "node ./ops/dev/run.mjs fabric-reset",
    "fabric:seed": "tsx scripts/fabric-ledger.ts seed",
    "fabric:query:history": "tsx scripts/fabric-ledger.ts history",
    "fabric:query:by-road": "tsx scripts/fabric-ledger.ts by-road",

    "----DEPLOY----": "",
    "deploy": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/deploy/deploy.ps1",
    "deploy:local": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/deploy/deploy.ps1 -Target local",
    "deploy:local:apps": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/deploy/deploy.ps1 -Target local -StartApps -SkipFabric",
    "deploy:kind": "bash ./ops/deploy/deploy-kind.sh",
    "deploy:kind:ps1": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/deploy/deploy.ps1 -Target kind",
    "deploy:k8s": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/deploy/deploy.ps1 -Target k8s",
    "deploy:aws": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./ops/deploy/deploy.ps1 -Target aws",

    "----KUBERNETES----": "",
    "k8s:up": "bash ./ops/deploy/deploy-kind.sh",
    "k8s:reset": "bash ./ops/deploy/deploy-kind.sh --reset",
    "k8s:down": "kind delete cluster --name roadwatch",
    "k8s:logs": "kubectl logs -n roadwatch -l app=gateway -f --prefix",
    "k8s:status": "kubectl get pods -n roadwatch",

    "----SEED----": "",
    "seed:backend": "pnpm --filter @roadwatch/gateway-api seed:backend",
    "seed:demo": "pnpm --filter @roadwatch/gateway-api seed:demo",
    "stress:platform": "node ./tools/load/stress-platform.mjs",
    "dlq:list": "bash ./scripts/dlq-redrive.sh list",
    "dlq:redrive": "bash ./scripts/dlq-redrive.sh redrive",
    "verify:lifecycle": "node ./scripts/verify-complaint-lifecycle.mjs",
    "smoke:endpoints": "node ./scripts/smoke-endpoints.mjs",
    "loadtest": "node ./tools/load/run-k6.mjs",
    "benchmarks:report": "node ./tools/benchmarks/generate-roadwatch-benchmarks.mjs",

    "----CLEAN----": "",
    "clean": "turbo run clean",
    "clean:all": "turbo run clean && pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "clean:build": "turbo run clean"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@hyperledger/fabric-gateway": "^1.10.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "turbo": "latest",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
