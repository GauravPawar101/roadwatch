# fabric-anchor-consumer local development example

# PostgreSQL via the local PgBouncer endpoint
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:6432/roadwatch

# Kafka: use the local broker by default, or uncomment the Upstash REST fields.
KAFKA_BROKERS=127.0.0.1:9094

# Consumer identity
KAFKA_CONSUMER_GROUP_ID=fabric-anchor-consumer-v1
KAFKA_CONSUMER_INSTANCE_ID=fabric-anchor-local-1

# Gateway registration
NODE_ENV=development
SERVICE_NAME=fabric-anchor-consumer
SERVICE_URL=service://fabric-anchor-consumer
GATEWAY_URL=http://127.0.0.1:3100
SERVICE_REGISTRY_SECRET=

# Hyperledger Fabric gateway
FABRIC_TLS_CERT_PATH=./path/to/tls/ca.crt
FABRIC_PEER_ENDPOINT=localhost:17051
FABRIC_PEER_HOST_ALIAS=peer0.citizenorg.example.com
FABRIC_CHANNEL_NAME=roadwatch-channel
FABRIC_CHAINCODE_NAME=roadwatch

# X.509 identity for the gateway signer
FABRIC_X509_CERT_PATH=./path/to/user/cert.pem
FABRIC_X509_KEY_PATH=./path/to/user/key.pem
