{
  "name": "@roadwatch/fabric-anchor-consumer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsx index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@hyperledger/fabric-gateway": "^1.10.1",
    "@roadwatch/core": "workspace:*",
    "@roadwatch/kafka": "workspace:*",
    "@roadwatch/sidecar-auth": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "dotenv": "^16.6.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  }
}
