# Cassandra (CQL)
# Contact points for Cassandra (host:port). For local docker use cassandra:9042
CASSANDRA_CONTACT_POINTS=cassandra:9042
CASSANDRA_KEYSPACE=roadwatch
CASSANDRA_LOCAL_DC=datacenter1

# Hugging Face
HF_API_KEYS=your_hf_api_key_1,your_hf_api_key_2

# Pinecone (managed) - if using Pinecone cloud
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=your_pinecone_environment
PINECONE_INDEX=roadwatch-media

# Pinata
PINATA_JWT=your_pinata_jwt_here
PINATA_WEBHOOK_SECRET=optional_pinata_webhook_shared_secret

PORT=4000
