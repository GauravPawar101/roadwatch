# media-ingest local development example

# PostgreSQL via the local PgBouncer endpoint
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:6432/roadwatch

# Hugging Face API keys (comma-separated)
HF_API_KEYS=your_hf_api_key_1,your_hf_api_key_2

# Optional Hugging Face model override
HF_MODEL=openai/clip-vit-base-patch32

# Vector store for embeddings; the service can still fall back to Postgres pgvector
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=roadwatch-media

# Supabase Storage helper used by the upload endpoint
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_S3_ACCESS_KEY_ID=your-supabase-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY_ID=your-supabase-s3-secret-access-key
SUPABASE_STORAGE_BUCKET=roadwatch-media

PORT=4000

