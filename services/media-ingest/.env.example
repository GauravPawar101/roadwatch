# media-ingest local development example

# PostgreSQL via the local PgBouncer endpoint
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:6432/roadwatch

# Hugging Face API keys (comma-separated)
HF_API_KEYS=your_hf_api_key_1,your_hf_api_key_2

# Pinecone (managed)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=your_pinecone_environment
PINECONE_INDEX=roadwatch-media

# Pinata
PINATA_JWT=your_pinata_jwt_here
PINATA_WEBHOOK_SECRET=optional_pinata_webhook_shared_secret

PORT=4000
