# Database (Cassandra)
# Contact points for Cassandra (host:port). For local docker use cassandra:9042
CASSANDRA_CONTACT_POINTS=cassandra:9042
CASSANDRA_KEYSPACE=roadwatch
CASSANDRA_LOCAL_DC=datacenter1

# Service
NODE_ENV=development
SERVICE_NAME=scheduler
SERVICE_PORT=3001

# Cron schedules (crontab format: minute hour day month day_of_week)
# Sync offline queue every 5 minutes
CRON_SYNC_QUEUE="*/5 * * * *"

# Recalculate karma scores every hour
CRON_KARMA_RECALC="0 * * * *"

# Check SLA breaches every 30 seconds
CRON_SLA_CHECK="*/30 * * * * *"

# Cleanup audit logs daily at 2 AM
CRON_AUDIT_CLEANUP="0 2 * * *"

# Generate reports daily at 1 AM
CRON_REPORT_GENERATION="0 1 * * *"

# Health check interval (ms)
HEALTH_CHECK_INTERVAL=30000
