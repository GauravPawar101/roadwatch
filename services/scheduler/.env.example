# scheduler local development example

# PostgreSQL via the local PgBouncer endpoint
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:16432/roadwatch

# Service identity
NODE_ENV=development
SERVICE_NAME=scheduler
GATEWAY_URL=http://127.0.0.1:3100

# Cron schedules (crontab format) — night jobs use SCHEDULER_TZ
CRON_SYNC_QUEUE="*/5 * * * *"
CRON_KARMA_RECALC="0 * * * *"
CRON_SLA_CHECK="0 2 * * *"
CRON_INSPECTION_CHECK="30 2 * * *"
CRON_AUDIT_CLEANUP="0 2 * * *"
CRON_REPORT_GENERATION="0 1 * * *"
SCHEDULER_TZ="Asia/Kolkata"
SLA_SKIP_HOLIDAYS="true"
SLA_GRACE_HIGHWAY_HOURS="168"
SLA_GRACE_LOCAL_HOURS="48"
INSPECTION_GRACE_HOURS="24"
KARMA_SLA_CONTRACTOR="-20"
KARMA_SLA_ENGINEER="-15"
KARMA_RECURRENCE="-25"
ORG_KARMA_BASE_PENALTY="-10"
ORG_KARMA_REPAIR_BONUS="5"
ORG_KARMA_NEW_ROAD_BONUS="8"

# Used to fan out SLA / escalation alerts via gateway
INTERNAL_SERVICE_TOKEN=

# Health check interval in milliseconds
HEALTH_CHECK_INTERVAL=30000
