# scheduler local development example

# PostgreSQL via the local PgBouncer endpoint
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:6432/roadwatch

# Service registration
NODE_ENV=development
SERVICE_NAME=scheduler
SERVICE_URL=service://scheduler
GATEWAY_URL=http://127.0.0.1:3100
SERVICE_REGISTRY_SECRET=

# Cron schedules (crontab format)
CRON_SYNC_QUEUE="*/5 * * * *"
CRON_KARMA_RECALC="0 * * * *"
CRON_SLA_CHECK="*/30 * * * *"
CRON_AUDIT_CLEANUP="0 2 * * *"
CRON_REPORT_GENERATION="0 1 * * *"

# Health check interval in milliseconds
HEALTH_CHECK_INTERVAL=30000
