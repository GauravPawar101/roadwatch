# webhook-handler local development example

# PostgreSQL via the local PgBouncer endpoint
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:6432/roadwatch

# Kafka broker(s)
KAFKA_BROKERS=127.0.0.1:9094
KAFKA_GROUP_ID=webhook-handler
KAFKA_CONSUMER_TIMEOUT=3000

# Service registration
NODE_ENV=development
SERVICE_NAME=webhook-handler
SERVICE_URL=service://webhook-handler
GATEWAY_URL=http://127.0.0.1:3100
SERVICE_REGISTRY_SECRET=

# Logging
LOG_LEVEL=info

# Optional external notification services
# FCM_SERVER_KEY=your-fcm-key
# TWILIO_ACCOUNT_SID=your-sid
# TWILIO_AUTH_TOKEN=your-token
# TWILIO_FROM_NUMBER=your-phone
