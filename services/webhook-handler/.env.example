# Database (Cassandra)
# Contact points for Cassandra (host:port). For local docker use cassandra:9042
CASSANDRA_CONTACT_POINTS=cassandra:9042
CASSANDRA_KEYSPACE=roadwatch
CASSANDRA_LOCAL_DC=datacenter1

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_GROUP_ID=webhook-handler
KAFKA_CONSUMER_TIMEOUT=3000

# Service
NODE_ENV=development
SERVICE_NAME=webhook-handler
SERVICE_PORT=3002

# Logging
LOG_LEVEL=info

# Optional: External notification services
# FCM_SERVER_KEY=your_fcm_key
# TWILIO_ACCOUNT_SID=your_sid
# TWILIO_AUTH_TOKEN=your_token
# TWILIO_FROM_NUMBER=your_phone
