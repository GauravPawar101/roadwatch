# RoadWatch — Local development example env
# Copy this to `.env` or into service-specific `.env` files and adjust secrets as needed.

# Infrastructure (host-facing ports)
CASSANDRA_CONTACT_POINTS=127.0.0.1:9042
KAFANDRA_PLACEHOLDER=unused
KAFKA_BROKER=127.0.0.1:9094
REDIS_URL=redis://127.0.0.1:16379/0

# Gateway API
PORT=3100
CASSANDRA_KEYSPACE=roadwatch
CASSANDRA_LOCAL_DC=datacenter1
JWT_SECRET=local_development_cryptographic_secret

# Backend API
# The backend defaults to 4001. On some Windows hosts that port is unusable,
# the `start-all.ps1` script detects and exports a fallback (e.g. 5001) to
# `BACKEND_PORT` before launching the backend. You can also set it manually.
BACKEND_PORT=4001

# Frontend
# Vite default port
VITE_PORT=5173
VITE_API_BASE=http://localhost:3100

# Optional (Upstash / cloud) overrides
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# UPSTASH_KAFKA_REST_URL=
# UPSTASH_KAFKA_REST_TOKEN=

# ----
# Notes:
# - Use host-facing ports above when running services on the host (not inside containers).
# - Containerized services should use internal DNS names (e.g. cassandra:9042, kafka:29092, redis:6379).