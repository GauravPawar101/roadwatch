# RoadWatch local development starter.
# Copy this file to .env or service-specific .env files and replace the placeholder values.

# Host-facing infrastructure
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:6432/roadwatch
KAFKA_BROKER=127.0.0.1:9094
REDIS_URL=redis://127.0.0.1:16379/0

# Shared app defaults
PORT=3100
BACKEND_PORT=4001
VITE_PORT=5173
VITE_API_BASE=http://localhost:3100
JWT_SECRET=replace-with-a-long-random-secret

# Gateway API requires Redis REST credentials.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Optional Kafka REST credentials for cloud setups.
# UPSTASH_KAFKA_REST_URL=https://your-upstash-kafka-url
# UPSTASH_KAFKA_REST_USERNAME=token
# UPSTASH_KAFKA_REST_PASSWORD=your-upstash-kafka-password
# UPSTASH_KAFKA_REST_TOKEN=your-upstash-kafka-token