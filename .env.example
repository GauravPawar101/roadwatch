# RoadWatch configuration.
#
# Copy to `.env` (gitignored — never commit real values) and fill in.
# `.env.example` itself must only ever contain placeholders.
#
# Precedence for infrastructure endpoints, implemented once in
# @roadwatch/core (config/endpoints.ts):
#
#   cloud (*_CLOUD_*)  ->  explicit URL  ->  in-cluster parts  ->  local default
#
# Cloud variables are checked FIRST on purpose: the Kubernetes manifests always
# materialise DATABASE_URL / REDIS_URL / KAFKA_*_BROKERS from the infra
# ConfigMap, so an "explicit" tier would always win and a managed endpoint could
# never take effect. Verified by tools/verify/cloud-precedence.mts.

# ─────────────────────────────────────────────────────────────────────────────
# Managed infrastructure — the cloud tier
# ─────────────────────────────────────────────────────────────────────────────

# Managed PostgreSQL (Aiven / Neon / Supabase / RDS / Cloud SQL).
#
# TLS: managed databases refuse plaintext, so keep a mode. ?sslmode=require is
# what providers document, and it is what you should write here — the application
# rewrites it to node-postgres' own `no-verify` spelling at pool-construction
# time, because since pg-connection-string 2.7 `require` is an alias for
# `verify-full` and a provider's private CA is not in the system trust store.
# See docs/MANAGED_SERVICES.md. To actually verify the chain, install the
# provider CA and write ?sslmode=verify-full, which is left untouched.
#
# The database must already have the schema. The Postgres image only runs
# docker/postgres/init.sql on the first start of an empty data directory, so a
# managed database needs it applied explicitly:
#   npm run ops:apply-schema
# Then confirm with: npm run verify:schema
DATABASE_CLOUD_URL=

# Managed Redis — Upstash.
#
# Two ways to name the same database; either works.
#
# 1. A TCP/TLS connection string. Upstash is TLS-only, so the scheme must be
#    rediss:// (not redis://).
REDIS_CLOUD_URL=
# 2. Or the pair the Upstash console shows, and the application will derive the
#    rediss:// URL from them. Use this if you have not built the string by hand.
#UPSTASH_REDIS_REST_URL=
#UPSTASH_REDIS_REST_TOKEN=

# Managed Kafka. Two clusters: operational events, and Fabric anchor backpressure.
# Bootstrap servers only, comma separated. Hosted providers use 9094 (SASL/SSL)
# rather than the plaintext 9092.
#
# With no managed cluster set, both fall back to the on-device compose brokers
# on 9095/9094, which are plaintext.
KAFKA_EVENTS_CLOUD_BROKERS=
KAFKA_HLF_CLOUD_BROKERS=

# Kafka authentication. REQUIRED for Confluent Cloud, Redpanda Cloud and Aiven —
# the client cannot connect without it. Both providers use SASL over TLS.
#
#   Confluent Cloud  mechanism=plain       user=API key   password=API secret
#   Redpanda Cloud   mechanism=scram-sha-256
#   Aiven            mechanism=scram-sha-256, password=<api-key>:<secret>
#
# These apply to both clusters unless the per-cluster variables below are set.
#
# KAFKA_SSL: leave it EMPTY to have TLS inferred from the brokers themselves —
# every broker must be remote, so a hosted cluster gets TLS and the on-device
# plaintext stack does not. Set it only to override that, and note the startup
# log reports a setting that contradicts the brokers it will be used against.
KAFKA_SSL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USER=
KAFKA_SASL_PASSWORD=
# Optional: a provider-issued CA bundle, when the broker uses a private CA.
KAFKA_SSL_CA=

# Per-cluster credential overrides, when the two providers are different
# accounts with different keys. Leave blank to use the shared values above.
KAFKA_EVENTS_SASL_MECHANISM=
KAFKA_EVENTS_SASL_USER=
KAFKA_EVENTS_SASL_PASSWORD=
KAFKA_HLF_SASL_MECHANISM=
KAFKA_HLF_SASL_USER=
KAFKA_HLF_SASL_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Managed-endpoint policy
# ─────────────────────────────────────────────────────────────────────────────

# Every service resolves its endpoints the same way and logs what it got at
# startup: which components are on the managed tier, which fell back to the
# device, and which managed value is configured but unusable (a Postgres URL
# with no sslmode, a redis:// URL for a TLS-only cache, TLS forced on against
# plaintext brokers, a broker with no port).
#
# Set this to true to make a configured-but-unusable managed endpoint refuse to
# start instead of degrading quietly. A component with nothing configured is
# still allowed, so a fully local run keeps working.
#
# Once every managed endpoint above is filled in, set this on.
INFRA_REQUIRE_MANAGED=false

# Verify what is configured, without printing any secret value:
#   npm run verify:managed      reachability + which tier each component resolved
#   npm run verify:schema       which of the 53 tables exist
#   npm run verify:write-path   run the real create transaction, then delete it
#   npm run ops:apply-schema    WRITES: apply docker/postgres/init.sql

# ─────────────────────────────────────────────────────────────────────────────
# Application secrets
# ─────────────────────────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
JWT_SECRET=
ACCESS_SECRET=
REFRESH_SECRET=
INTERNAL_SERVICE_TOKEN=
# How long an incomplete idempotency claim stays unreclaimable. See
# apps/gateway-api/src/idempotency.ts.
IDEMPOTENCY_CLAIM_TTL_SECONDS=60

# ─────────────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────────────

# Sentry. SENTRY_DSN is the only value required at runtime; the rest are needed
# to upload source maps from CI so stack traces resolve to original TypeScript.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# CI only. Never exposed to the application.
SENTRY_AUTH_TOKEN=
# Derived from the CI commit at runtime; not set by hand.
# SENTRY_RELEASE=

# Simple Analytics. Not a secret — it is the site domain, and the script is
# cookie-less. Used by the frontend only.
VITE_SIMPLE_ANALYTICS_DOMAIN=

# ─────────────────────────────────────────────────────────────────────────────
# Host-facing infrastructure (local development defaults)
# ─────────────────────────────────────────────────────────────────────────────
# docker-compose host port mappings — must match .env values if exported
TOP_POSTGRES_HOST_PORT=16432
TOP_PGBOUNCER_HOST_PORT=16432
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:16432/roadwatch
KAFKA_HLF_BROKERS=127.0.0.1:9094
KAFKA_EVENTS_BROKERS=127.0.0.1:9095
KAFKA_BROKER=127.0.0.1:9095
REDIS_URL=redis://127.0.0.1:16379/0

# ─────────────────────────────────────────────────────────────────────────────
# Shared app defaults
# ─────────────────────────────────────────────────────────────────────────────
PORT=3100
BACKEND_PORT=4001
VITE_PORT=5173
VITE_API_BASE=http://localhost:3100

# Active district (see config/deploy/districts.json)
RW_DEFAULT_DISTRICT_CODE=MH-MUM
# RW_DEFAULT_DISTRICT_ID=7a01f2c1-2e3b-4c19-9e15-0a1d0d66be33
