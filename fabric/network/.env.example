# Hyperledger Fabric network — local dev defaults.
# Copied to .env by setup.ps1 / start-all.ps1 on first run.

FABRIC_VERSION=2.5.15
FABRIC_CHANNEL_NAME=roadwatch-india
FABRIC_CHANNEL=roadwatch-india

FABRIC_NETWORK_NAME=roadwatch_fabric_net
FABRIC_LEDGER_STATE_DB=goleveldb

# Host ports (mapped in docker/docker-compose.yaml)
FABRIC_ORDERER_PORT=17050
FABRIC_NHAI_CA_PORT=17054
FABRIC_ROADWATCH_CA_PORT=18054
FABRIC_NHAI_PEER_PORT=17051
FABRIC_NHAI_CHAINCODE_PORT=17052
FABRIC_NHAI_OPERATIONS_PORT=17444
FABRIC_ROADWATCH_PEER_PORT=19051
FABRIC_ROADWATCH_CHAINCODE_PORT=19052
FABRIC_ROADWATCH_OPERATIONS_PORT=19445

# Container names (optional overrides)
FABRIC_ORDERER_CONTAINER_NAME=roadwatch_orderer1
FABRIC_NHAI_PEER_CONTAINER_NAME=roadwatch_peer0_nhai
FABRIC_ROADWATCH_PEER_CONTAINER_NAME=roadwatch_peer0_roadwatch
FABRIC_CA_NHAI_CONTAINER_NAME=roadwatch_ca_nhai
FABRIC_CA_ROADWATCH_CONTAINER_NAME=roadwatch_ca_roadwatch

# MSP / chaincode (used by ops/deploy/fabric-start.sh)
FABRIC_MSP_ID=NHAIMSP
FABRIC_CHAINCODE_NAME=complaint-anchor
CORE_PEER_LOCALMSPID=NHAIMSP
