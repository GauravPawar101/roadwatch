# =========================================================================
# LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# =========================================================================
# This is a LOCAL DEVELOPMENT environment - all services run in Docker locally
# No external cloud services or separate deployments needed

# [1] Cassandra Local Database
# Credentials/connection settings for local Cassandra running in Docker
# For local docker-compose this commonly points to `cassandra:9042`
CASSANDRA_CONTACT_POINTS=cassandra:9042
CASSANDRA_KEYSPACE=roadwatch
CASSANDRA_LOCAL_DC=datacenter1

# [2] Kafka - Local Message Broker
# Running locally in Docker via docker-compose
KAFKA_BROKERS=kafka:29092
KAFKA_BROKER_PORT=9092
ZOOKEEPER_HOST=zookeeper
ZOOKEEPER_PORT=2181

# [3] Redis - Local Cache
# Running locally in Docker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# [4] JWT Configuration - Development
# Generate a local secret for development (can be anything for local dev)
JWT_SECRET=local-dev-secret-key-change-in-production-absolutely-never-use-this-in-production

# [5] Application Environment
NODE_ENV=development
DEBUG=roadwatch:*
LOG_LEVEL=debug

# [6] Service Configuration
SERVICE_NAME=roadwatch-local-dev
API_PORT=3000
WEBHOOK_PORT=3001

# [7] Fabric Blockchain - Local Development
# These point to local development fabric network (if available)
FABRIC_PEER_ENDPOINT=peer0.nhai.example.com:7051
FABRIC_MSP_ID=NHAIMSP
FABRIC_CHANNEL_NAME=roadwatch-india
FABRIC_CHAINCODE_NAME=complaint-anchor

# [8] Cron Job Schedules (Development)
CRON_SYNC_QUEUE="*/5 * * * *"
CRON_KARMA_RECALC="0 * * * *"
CRON_SLA_CHECK="*/30 * * * *"
CRON_AUDIT_CLEANUP="0 2 * * *"
CRON_REPORT_GENERATION="0 1 * * *"
