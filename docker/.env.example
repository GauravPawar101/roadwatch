# RoadWatch Docker environment example.
# Use this when services run inside the local docker-compose network.

# PostgreSQL via PgBouncer
DATABASE_URL=postgresql://postgres:postgres@pgbouncer:6432/roadwatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=roadwatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Kafka and Redis inside Docker
KAFKA_HLF_BROKERS=kafka-hlf:29092
KAFKA_EVENTS_BROKERS=kafka-events:29092
KAFKA_BROKERS=kafka-events:29092
KAFKA_BROKER_PORT=9092
ZOOKEEPER_HLF_HOST=zookeeper-hlf
ZOOKEEPER_EVENTS_HOST=zookeeper-events
ZOOKEEPER_PORT=2181
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# App/runtime defaults
NODE_ENV=development
DEBUG=roadwatch:*
LOG_LEVEL=debug
JWT_SECRET=replace-with-a-long-random-secret

# Service registration / discovery
SERVICE_NAME=roadwatch-local-dev
SERVICE_URL=service://roadwatch-local-dev
GATEWAY_URL=http://gateway-api:3100

# Local service ports (used when running helpers on the host)
API_PORT=3000
WEBHOOK_PORT=3001

# Fabric integration
FABRIC_PEER_ENDPOINT=peer0.nhai.example.com:7051
FABRIC_MSP_ID=NHAIMSP
FABRIC_CHANNEL_NAME=roadwatch-india
FABRIC_CHAINCODE_NAME=complaint-anchor

# Scheduler jobs
CRON_SYNC_QUEUE="*/5 * * * *"
CRON_KARMA_RECALC="0 * * * *"
CRON_SLA_CHECK="0 2 * * *"
CRON_INSPECTION_CHECK="30 2 * * *"
CRON_AUDIT_CLEANUP="0 2 * * *"
CRON_REPORT_GENERATION="0 1 * * *"
SCHEDULER_TZ="Asia/Kolkata"
SLA_SKIP_HOLIDAYS="true"
SLA_GRACE_HIGHWAY_HOURS="168"
SLA_GRACE_LOCAL_HOURS="48"
INSPECTION_GRACE_HOURS="24"
KARMA_SLA_CONTRACTOR="-20"
KARMA_SLA_ENGINEER="-15"
KARMA_RECURRENCE="-25"
ORG_KARMA_BASE_PENALTY="-10"
