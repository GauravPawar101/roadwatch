# gateway-api local dev
# Copy to .env and adjust as needed.

# Server
PORT=3100
NODE_ENV=development

# Cassandra (CQL)
# Contact points should point to your Cassandra nodes (host:port). Default for local docker is cassandra:9042
CASSANDRA_CONTACT_POINTS=cassandra:9042
CASSANDRA_KEYSPACE=roadwatch
CASSANDRA_LOCAL_DC=datacenter1

# Auth
JWT_SECRET=local_development_cryptographic_secret
OTP_TTL_SECONDS=300
ALLOW_DEV_OTP_ECHO=true

# Optional PII protection (recommended)
# PHONE_HASH_PEPPER=some-long-random-string
# PHONE_ENC_KEY=base64-32-byte-key

# LLM (pick one)
# Gemini (hosted)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Ollama (local)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1

# llama.cpp server (OpenAI-compatible)
# LLAMACPP_BASE_URL=http://127.0.0.1:8080
# LLAMACPP_MODEL=llama

# Comma-separated priority list
LLM_FALLBACK_ORDER=gemini,ollama,llamacpp

# Kafka (required; enables event publishing)
#
# Option A: Upstash Kafka REST (cloud)
# - In the Upstash console, look for the "REST API" credentials.
# - Some UIs show URL + username/password, others show URL + token.
#
# UPSTASH_KAFKA_REST_URL=https://....upstash.io
# UPSTASH_KAFKA_REST_USERNAME=...
# UPSTASH_KAFKA_REST_PASSWORD=...
# UPSTASH_KAFKA_REST_TOKEN=...     # alternative to username/password; treated as REST password (username defaults to "token")
#
# Option B: Local Kafka broker (docker-compose)
# - No username/password required unless you enable SASL yourself.
# - Use a host-reachable broker address, e.g. localhost:9094
#
# KAFKA_BROKER=127.0.0.1:9094
# KAFKA_BROKERS=127.0.0.1:9094,127.0.0.1:9095

# Redis (required; used for Kafka publish idempotency/dedupe)
# Upstash Redis REST
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Fabric (optional; used by Fabric components/scripts)
# NOTE: repo contains multiple naming schemes; prefer the *_IDENTITY_* + FABRIC_CHANNEL/FABRIC_CHAINCODE used by scripts/tests.
# FABRIC_PEER_ENDPOINT=peer0.example.com:7051
# FABRIC_PEER_HOST_ALIAS=peer0.example.com
# FABRIC_MSP_ID=RoadWatchMSP
# FABRIC_TLS_CERT_PATH=/abs/path/to/peer/tls/ca.crt
# FABRIC_IDENTITY_CERT_PATH=/abs/path/to/user/cert.pem
# FABRIC_IDENTITY_KEY_PATH=/abs/path/to/user/key.pem
# FABRIC_CHANNEL=roadwatch-india
# FABRIC_CHAINCODE=complaint-anchor
