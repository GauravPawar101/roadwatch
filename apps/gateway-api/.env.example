# gateway-api local development example
# Copy to .env and replace the placeholder values.

# Server
PORT=3100
NODE_ENV=development

# PostgreSQL via PgBouncer
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:6432/roadwatch

# Auth
JWT_SECRET=replace-with-a-long-random-secret
OTP_TTL_SECONDS=300
ALLOW_DEV_OTP_ECHO=true

# Optional PII protection
# PHONE_HASH_PEPPER=replace-with-a-long-random-string
# PHONE_ENC_KEY=base64-encoded-32-byte-key

# LLM (choose one or leave all unset)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
# LLAMACPP_BASE_URL=http://127.0.0.1:8080
# LLAMACPP_MODEL=llama
LLM_FALLBACK_ORDER=gemini,ollama,llamacpp

# Kafka: use either local broker values or Upstash REST credentials.
KAFKA_BROKER=127.0.0.1:9094
# KAFKA_BROKERS=127.0.0.1:9094,127.0.0.1:9095
# UPSTASH_KAFKA_REST_URL=https://your-upstash-kafka-url
# UPSTASH_KAFKA_REST_USERNAME=token
# UPSTASH_KAFKA_REST_PASSWORD=your-upstash-kafka-password
# UPSTASH_KAFKA_REST_TOKEN=your-upstash-kafka-token

# Redis REST credentials required by the gateway runtime.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Optional Fabric / service discovery settings
# FABRIC_PEER_ENDPOINT=peer0.example.com:7051
# FABRIC_PEER_HOST_ALIAS=peer0.example.com
# FABRIC_MSP_ID=RoadWatchMSP
# FABRIC_TLS_CERT_PATH=/abs/path/to/peer/tls/ca.crt
# FABRIC_IDENTITY_CERT_PATH=/abs/path/to/user/cert.pem
# FABRIC_IDENTITY_KEY_PATH=/abs/path/to/user/key.pem
# FABRIC_CHANNEL=roadwatch-india
# FABRIC_CHAINCODE=complaint-anchor
# SERVICE_REGISTRY_SECRET=
