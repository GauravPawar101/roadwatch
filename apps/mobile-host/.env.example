# RoadWatch mobile host environment example.
# These values are bundled into the app, so only use public or low-risk configuration here.

# Backend API gateway
# iOS simulator / host: http://localhost:3100
# Android emulator: http://10.0.2.2:3100
API_GATEWAY_URL=http://localhost:3100

# Public client-side services
GEMINI_API_KEY=your-public-gemini-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_STORAGE_BUCKET=roadwatch-media
