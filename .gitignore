node_modules

# ── Environment / secrets (NEVER commit real env files) ─────────────────────
# Ignore every .env variant anywhere in the tree.
.env
**/.env
.env.*
**/.env.*
*.env
**/*.env
.envrc
**/.envrc
.env.backup
.env.bak
.env.save
.env.old
.env.tmp
.env.*.local
*.local.env
*.secret
*.secrets
*secret*.local

# Only plain template files named exactly ".env.example" may be committed.
!.env.example
!**/.env.example

# Explicit denials (even if someone force-adds / renames)
docker/.env
fabric/network/.env
apps/mobile-host/ios/.xcode.env
services/media-ingest/.supabase.env
scripts/test-ids.env
SECRETS.md
**/SECRETS.md
credentials.txt
**/credentials.txt
**/credentials.json
**/*credentials*.txt
**/*secrets*.txt
**/.aws/
**/aws.json

# Fabric private keystore files (often extensionless)
**/keystore/
**/priv_sk
**/*_sk
**/IssuerSecretKey
**/IssuerRevocationPrivateKey

# ── Fabric / Hyperledger binaries (NEVER commit — large, download locally) ─
# Root install dir used by Fabric bootstrap scripts
/bin/
bin/
**/bin/peer
**/bin/orderer
**/bin/configtxgen
**/bin/configtxlator
**/bin/cryptogen
**/bin/discover
**/bin/ledgerutil
**/bin/osnadmin
**/bin/fabric-*
# Also catch if dropped outside /bin
peer.exe
orderer.exe
configtxgen.exe
configtxlator.exe
cryptogen.exe

# ── Hyperledger Fabric (generated — never commit keys/certs/blocks) ────────
fabric/network/organizations/
fabric/network/channel-artifacts/*
!fabric/network/channel-artifacts/.gitkeep
fabric/network/system-genesis-block/
fabric/network/*.tar.gz
fabric/network/**/*.tar.gz
fabric/network/**/*.block
fabric/network/**/*.tx
fabric-samples/
config_block.json
config_block.pb
core.yaml

# ── Build outputs / caches ───────────────────────────────────────────────────
dist
**/dist
build
**/build
coverage
**/coverage
.turbo
**/.turbo
.vite
**/.vite
.expo
**/.expo
.tsbuildinfo
**/*.tsbuildinfo
.next
**/.next
.nuxt
**/.nuxt
.cache
**/.cache
.parcel-cache
**/.parcel-cache
.swc
**/.swc
.eslintcache
**/.eslintcache

# Accidental TypeScript emit under src/ (should only be in dist/)
packages/**/src/**/*.js
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts.map
!packages/**/src/**/*.test.js

# Accidental package root compiles (keep source .ts only)
packages/kafka/*.js
packages/redis/*.js

# ── Logs / runtime ───────────────────────────────────────────────────────────
*.log
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pids/
logs/
*.pid

# ── Editor / AI tooling ────────────────────────────────────────────────────
.vscode/
.zed/
.cursor/
.codex/
.gemini/
.mcp.json
.aider*
agent-transcripts/

# ── Netlify / hosting ──────────────────────────────────────────────────────
.netlify/

# ── React Native / mobile ──────────────────────────────────────────────────
apps/mobile-host/ios/Pods/
apps/mobile-host/ios/build/
apps/mobile-host/ios/DerivedData/
apps/mobile-host/android/.gradle/
apps/mobile-host/android/build/
apps/mobile-host/android/app/build/
apps/mobile-host/android/local.properties
.metro-cache
**/.metro-cache
*.keystore
*.jks
*.apk
*.aab
*.hprof

# ── Docker local volumes / data ────────────────────────────────────────────
docker/volumes/
postgres_data/

# ── Kubernetes / deploy temp ───────────────────────────────────────────────
kubeconfig*
.kube/local/
.kube/
*.kubeconfig
*-kubeconfig.yaml
*-kubeconfig.yml

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Keys and certificates ──────────────────────────────────────────────────
*.key
*.pem
*.p12
*.pfx
*.jwk
*.crt
!fabric/network/config/**/*.pem

# ── Test / Python artifacts ────────────────────────────────────────────────
__pycache__/
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
*.pyc

# ── Terraform / IaC state (when added) ─────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
